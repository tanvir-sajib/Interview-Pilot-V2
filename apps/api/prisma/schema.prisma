generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["nativeTypes"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  role                String
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  refreshTokenVersion Int       @default(0)
}

model Question {
  id               String             @id @default(uuid())
  title            String
  text             String
  tags             String
  role             QuestionRole
  seniority        QuestionSeniority
  category         QuestionCategory
  difficulty       QuestionDifficulty
  expectedConcepts String
  rubric           String
  language         QuestionLanguage
  status           QuestionStatus     @default(DRAFT)
  isActive         Boolean            @default(true)
  authorId         String
  versions         QuestionVersion[]
}

model QuestionVersion {
  id               String   @id @default(uuid())
  questionId       String
  versionNumber    Int
  role             String
  seniority        String
  category         String
  difficulty       String
  tags             String
  expectedConcepts String
  rubric           String
  language         String
  content          String
  createdAt        DateTime @default(now())
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, versionNumber])
}

enum QuestionRole {
  TECHNICAL
  ADMIN
}

enum QuestionSeniority {
  JUNIOR
  MID
  SENIOR
}

enum QuestionCategory {
  TECHNICAL
  NON_TECHNICAL
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  COMPLETED
}

enum QuestionLanguage {
  EN
  ES
  FR
}
